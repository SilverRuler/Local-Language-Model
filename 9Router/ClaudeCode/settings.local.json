{
  "permissions": {
    "allow": [
      "Bash(printenv *)",
      "WebSearch",
      "WebFetch(domain\\:www\\.google.com)",
      "WebFetch(domain\\:www\\.reddit.com)",
      "WebFetch(domain\\:html.duckduckgo.com)",
      "WebFetch(domain\\:www\\.bing.com)",
      "WebFetch(domain\\:en.softonic.com)",
      "WebFetch(domain\\:web.archive.org)",
      "WebFetch(domain\\:silverpencil.tistory.com)",
      "Bash(sshpass *)",
      "Bash(tmux list-sessions *)",
      "Bash(tmux list-panes *)",
      "Bash(tmux capture-pane *)",
      "Bash(tmux send-keys *)",
      "Bash(chmod +x *)",
      "Bash(python3 *)",
      "Bash(tmux kill-session *)",
      "Bash(tmux new-session *)"
    ]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:20129/v1",
    "ANTHROPIC_AUTH_TOKEN": "YOUR_KEY",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "oc/hy3-free",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "oc/hy3-free",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "oc/hy3-free"
  }
}
